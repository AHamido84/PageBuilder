generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Locale {
  EN
  AR
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TemperatureClass {
  FROZEN
  CHILLED
  AMBIENT
}

enum MediaType {
  IMAGE
  DOCUMENT
  VIDEO
}

enum MenuLocation {
  HEADER
  FOOTER
}

enum SubmissionStatus {
  NEW
  REVIEWED
  SPAM
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  IN_PROGRESS
  WON
  LOST
}

enum LeadInquiryType {
  GENERAL
  INFO
  QUOTE
  BECOME_CUSTOMER
  SALES_INQUIRY
}

enum RedirectStatusCode {
  MOVED_PERMANENTLY
  FOUND
}

// ---------------------------------------------------------------------------
// Auth / RBAC
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  activityLogs            ActivityLog[]
  uploadedMedia           Media[]          @relation("MediaUploadedBy")
  pageRevisions           PageRevision[]
  blogPosts               BlogPost[]
  reviewedFormSubmissions FormSubmission[] @relation("FormSubmissionReviewedBy")
  assignedLeads           Lead[]           @relation("LeadAssignee")
  leadNotes               LeadNote[]

  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ---------------------------------------------------------------------------
// Pages / Page builder
// ---------------------------------------------------------------------------

model Page {
  id          String     @id @default(cuid())
  slug        String     @unique
  status      PageStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  sections  PageSection[]
  revisions PageRevision[]
  menuItems MenuItem[]
  seo       SEO?
  solution  Solution?

  @@index([status])
}

model PageSection {
  id        String   @id @default(cuid())
  pageId    String
  type      String
  order     Int
  dataEn    Json
  dataAr    Json
  settings  Json     @default("{}")
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
  @@index([pageId])
}

model PageRevision {
  id          String   @id @default(cuid())
  pageId      String
  snapshot    Json
  note        String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  page     Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([authorId])
  @@index([pageId, isPublished])
}

/** Catalog entry for a public /solutions/[slug] page. Owns only index-card metadata
 * (slug/icon/sortOrder/isPublished + a short name/description per locale); the actual
 * hero + unlimited sections live on the linked Page, reusing the full Page Builder
 * pipeline (SectionRenderer, publish/draft, revisions, per-page SEO) rather than a
 * second parallel section system. The linked Page uses a reserved slug
 * (`__solution__<slug>`, see src/lib/page-builder/homepage.ts's HOMEPAGE_SLUG for the
 * same convention) so it's never independently reachable via the [...slug] catch-all. */
model Solution {
  id          String   @id @default(cuid())
  slug        String   @unique
  icon        String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pageId String @unique
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  translations SolutionTranslation[]

  @@index([isPublished])
}

model SolutionTranslation {
  id               String  @id @default(cuid())
  solutionId       String
  locale           Locale
  name             String
  /** Shown on the /solutions index card only -- full body content lives in the linked Page's sections. */
  shortDescription String?

  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@unique([solutionId, locale])
  @@index([locale])
}

// ---------------------------------------------------------------------------
// Catalog: Category / Brand / Product (+ translations)
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  icon      String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  /** Shown in the dynamic "Featured Categories" Page Builder section (CATEGORY_GRID block,
   * dynamic mode) when true. Independent of `order`, which still governs plain admin/nav listing. */
  isFeatured    Boolean @default(false)
  /** Display order among featured categories only. Null falls back to `order` at render time --
   * see loadFeaturedCategories in category-brand-grid-render.tsx. */
  featuredOrder Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  imageId String?
  image   Media?  @relation(fields: [imageId], references: [id], onDelete: SetNull)

  translations CategoryTranslation[]
  products     Product[]
  menuItems    MenuItem[]
  seo          SEO?

  @@index([parentId])
  @@index([isFeatured])
}

model CategoryTranslation {
  id          String  @id @default(cuid())
  categoryId  String
  locale      Locale
  name        String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
}

model Brand {
  id        String   @id @default(cuid())
  slug      String   @unique
  website   String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  /** Shown in the dynamic Brand Grid section (BRAND_GRID block, dynamic mode) when true --
   * same pattern as Category.isFeatured. */
  isFeatured Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logoId String?
  logo   Media?  @relation("BrandLogo", fields: [logoId], references: [id], onDelete: SetNull)

  bannerId String?
  banner   Media?  @relation("BrandBanner", fields: [bannerId], references: [id], onDelete: SetNull)

  translations BrandTranslation[]
  products     Product[]
  seo          SEO?

  @@index([isFeatured])
}

model BrandTranslation {
  id          String  @id @default(cuid())
  brandId     String
  locale      Locale
  name        String
  description String?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, locale])
  @@index([locale])
}

model Product {
  id               String           @id @default(cuid())
  sku              String           @unique
  slug             String           @unique
  temperatureClass TemperatureClass
  isPublished      Boolean          @default(false)
  isFeatured       Boolean          @default(false)
  originCountry    String?
  weight           String?
  dimensions       String?
  relatedProductIds String[]        @default([])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  images       Media[]              @relation("ProductImages")
  videos       Media[]              @relation("ProductVideos")
  documents    Media[]              @relation("ProductDocuments")
  certifications Certification[]
  translations ProductTranslation[]
  seo          SEO?
  leads        Lead[]
  menuItems    MenuItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isPublished])
  @@index([isFeatured])
}

model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  locale           Locale
  name             String
  shortDescription String?
  description      String?
  packagingInfo    String?
  storageInfo      String?
  ingredients      String?
  nutritionInfo    String?
  allergens        String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

model Media {
  id           String    @id @default(cuid())
  fileName     String
  originalName String
  mimeType     String
  type         MediaType
  sizeBytes    Int
  url          String
  altTextEn    String?
  altTextAr    String?
  width        Int?
  height       Int?
  createdAt    DateTime  @default(now())

  uploadedById String?
  uploadedBy   User?   @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  categoriesUsing      Category[]
  brandLogoOf          Brand[]         @relation("BrandLogo")
  brandBannerOf        Brand[]         @relation("BrandBanner")
  productImagesOf      Product[]       @relation("ProductImages")
  productVideosOf      Product[]       @relation("ProductVideos")
  productDocumentsOf   Product[]       @relation("ProductDocuments")
  blogPostsCoverOf     BlogPost[]
  certificationsUsing  Certification[]
  siteSettingLogoOf    SiteSetting[]   @relation("SiteSettingLogo")
  siteSettingFaviconOf SiteSetting[]   @relation("SiteSettingFavicon")
  siteSettingOgImageOf SiteSetting[]   @relation("SiteSettingOgImage")
  seoOgImageOf         SEO[]

  @@index([uploadedById])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Menus
// ---------------------------------------------------------------------------

model Menu {
  id        String       @id @default(cuid())
  location  MenuLocation @unique
  updatedAt DateTime     @updatedAt

  items MenuItem[]
}

model MenuItem {
  id      String  @id @default(cuid())
  menuId  String
  labelEn String
  labelAr String
  url     String?
  order   Int     @default(0)

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  parentId String?
  parent   MenuItem?  @relation("MenuItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuItemHierarchy")

  pageId String?
  page   Page?   @relation(fields: [pageId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([menuId])
  @@index([parentId])
  @@index([categoryId])
  @@index([productId])
  @@index([pageId])
}

// ---------------------------------------------------------------------------
// Blog
// ---------------------------------------------------------------------------

model BlogCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameEn    String
  nameAr    String
  createdAt DateTime @default(now())

  posts BlogPost[]
}

model Tag {
  id     String @id @default(cuid())
  slug   String @unique
  nameEn String
  nameAr String

  posts BlogPost[] @relation("BlogPostTags")
}

model BlogPost {
  id          String     @id @default(cuid())
  slug        String     @unique
  titleEn     String
  titleAr     String
  excerptEn   String?
  excerptAr   String?
  contentEn   String
  contentAr   String
  status      PageStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  coverImageId String?
  coverImage   Media?  @relation(fields: [coverImageId], references: [id], onDelete: SetNull)

  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  tags Tag[] @relation("BlogPostTags")
  seo  SEO?

  @@index([categoryId])
  @@index([authorId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Forms / Leads
// ---------------------------------------------------------------------------

model Form {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameEn      String
  nameAr      String
  fields      Json
  notifyEmail String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions FormSubmission[]
}

model FormSubmission {
  id        String           @id @default(cuid())
  formId    String
  data      Json
  status    SubmissionStatus @default(NEW)
  ipAddress String?
  userAgent String?
  sourceUrl String?
  createdAt DateTime         @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?   @relation("FormSubmissionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([formId])
  @@index([status])
  @@index([reviewedById])
}

model Industry {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameEn    String
  nameAr    String
  createdAt DateTime @default(now())

  leads Lead[]
}

model Lead {
  id          String     @id @default(cuid())
  companyName String?
  contactName String
  email       String
  phone       String?
  message     String?
  status      LeadStatus @default(NEW)
  inquiryType LeadInquiryType @default(GENERAL)
  sourceUrl   String?
  locale      Locale?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  industryId String?
  industry   Industry? @relation(fields: [industryId], references: [id], onDelete: SetNull)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  notes LeadNote[]

  @@index([status])
  @@index([industryId])
  @@index([productId])
  @@index([assigneeId])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  body      String
  createdAt DateTime @default(now())

  lead     Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Certifications / Settings / SEO / Activity log
// ---------------------------------------------------------------------------

model Certification {
  id          String    @id @default(cuid())
  slug        String    @unique
  nameEn      String
  nameAr      String
  issuer      String?
  validFrom   DateTime?
  validUntil  DateTime?
  isPublished Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  imageId String?
  image   Media?  @relation(fields: [imageId], references: [id], onDelete: SetNull)

  products Product[]
}

model Faq {
  id          String   @id @default(cuid())
  questionEn  String
  questionAr  String
  answerEn    String
  answerAr    String
  category    String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([order])
}

model SiteSetting {
  id                      String   @id @default("singleton")
  siteNameEn              String
  siteNameAr              String
  contactEmail            String?
  contactPhone            String?
  whatsapp                String?
  address                 String?
  mapEmbedUrl             String?
  socialLinks             Json?
  businessHours           Json?
  footerAboutEn           String?
  footerAboutAr           String?
  newsletterTitleEn       String?
  newsletterTitleAr       String?
  newsletterBodyEn        String?
  newsletterBodyAr        String?
  seoDefaultTitleEn       String?
  seoDefaultTitleAr       String?
  seoDefaultDescriptionEn String?
  seoDefaultDescriptionAr String?
  analyticsId             String?
  gtmId                   String?
  metaPixelId             String?
  updatedAt               DateTime @updatedAt

  /** Deprecated -- superseded by `headerLogo` below (per-locale). Kept, unused, so no data is lost;
   * safe to drop in a future cleanup migration once `headerLogo` has been confirmed in use. */
  logoHeightDesktop Int?
  logoHeightMobile  Int?
  logoAlign         String?

  /** Per-locale header logo box sizing/alignment/behavior ({ en: {...}, ar: {...} }), see
   * src/lib/site-settings/header-logo.ts for the shape. Null/malformed rows fall back to defaults
   * via `normalizeHeaderLogoSettings`, so no migration of existing data is required. */
  headerLogo Json?

  logoId String?
  logo   Media?  @relation("SiteSettingLogo", fields: [logoId], references: [id], onDelete: SetNull)

  faviconId String?
  favicon   Media?  @relation("SiteSettingFavicon", fields: [faviconId], references: [id], onDelete: SetNull)

  defaultOgImageId String?
  defaultOgImage   Media?  @relation("SiteSettingOgImage", fields: [defaultOgImageId], references: [id], onDelete: SetNull)
}

model SEO {
  id            String   @id @default(cuid())
  titleEn       String?
  titleAr       String?
  descriptionEn String?
  descriptionAr String?
  canonicalUrl  String?
  noIndex       Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  ogImageId String?
  ogImage   Media?  @relation(fields: [ogImageId], references: [id], onDelete: SetNull)

  pageId String? @unique
  page   Page?   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  productId String?  @unique
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  blogPostId String?   @unique
  blogPost   BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  categoryId String?   @unique
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  brandId String? @unique
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model Redirect {
  id         String             @id @default(cuid())
  fromPath   String             @unique
  toPath     String
  statusCode RedirectStatusCode @default(MOVED_PERMANENTLY)
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    Locale?
  createdAt DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
