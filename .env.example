# Database (PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-32-byte-random-secret"

# Public site URL (used for absolute links, SEO, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed script: initial Super Admin account
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_ADMIN_NAME="Super Admin"
